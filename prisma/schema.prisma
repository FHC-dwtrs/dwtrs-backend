// ============================================================
// DWTRS - Document Workflow Tracking and Reporting System
// Final Database Schema
// PostgreSQL + Prisma 7
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum CaseStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  PENDING_CLARIFICATION
  SENT_BACK_FOR_CORRECTION
  APPROVED
  REJECTED
  COMPLETED
  ARCHIVED
}

enum UnitType {
  SECTOR
  DIRECTORATE
  GROUP
}

enum DecisionType {
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================================
// 1. CUSTOMER
// ============================================================

model Customer {
  customerId String @id @default(uuid()) @db.Uuid

  name    String  @db.VarChar(150)
  phone   String  @db.VarChar(30)
  email   String? @db.VarChar(255)
  address String? @db.VarChar(500)

  createdAt DateTime @default(now())

  cases Case[]

  @@index([phone])
  @@index([email])
  @@map("customer")
}

// ============================================================
// 2. CASE
// ============================================================

model Case {
  caseId String @id @default(uuid()) @db.Uuid

  customerId String @db.Uuid

  trackingNumber      String     @unique @db.VarChar(50)
  incomingReferenceNo String?    @db.VarChar(100)
  subject             String     @db.VarChar(500)
  status              CaseStatus @default(SUBMITTED)
  currentUnitId       String?    @db.Uuid
  version             Int        @default(1)
  submittedAt         DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  isArchived          Boolean  @default(false)
  archivedAt          DateTime?
  archivedBy          String?
  
  customer Customer @relation(fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Cascade)

  currentUnit OrganizationalUnit? @relation("CurrentCaseUnit", fields: [currentUnitId], references: [unitId], onDelete: SetNull, onUpdate: Cascade)

  documents           Document[]
  workflowAssignments WorkflowAssignment[]
  statusHistory       StatusHistory[]
  remarks             Remark[]
  decisions           Decision[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([customerId])
  @@index([incomingReferenceNo])
  @@index([currentUnitId])
  @@index([status])
  @@index([submittedAt])
  @@map("case")
}

// ============================================================
// 3. DOCUMENT
// ============================================================

model Document {
  documentId String @id @default(uuid()) @db.Uuid

  caseId       String @db.Uuid
  documentType String @db.VarChar(100)
  title        String @db.VarChar(255)

  fileName   String  @db.VarChar(255)
  storageKey String  @db.VarChar(500)
  mimeType   String  @db.VarChar(100)
  fileSize   BigInt
  checksum   String? @db.VarChar(128)

  uploadedBy String @db.Uuid

  deletedAt      DateTime?
  deletedBy      String?   @db.Uuid
  deletionReason String?   @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [caseId], onDelete: Cascade, onUpdate: Cascade)

  uploader User @relation("DocumentUploader", fields: [uploadedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  deleter User? @relation("DocumentDeletedBy", fields: [deletedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  attachments Attachment[]

  @@index([caseId])
  @@index([caseId, deletedAt])
  @@index([uploadedBy])
  @@index([deletedBy])
  @@index([checksum])
  @@map("document")
}

// ============================================================
// 4. ATTACHMENT
// ============================================================

model Attachment {
  attachmentId String @id @default(uuid()) @db.Uuid

  documentId String @db.Uuid

  fileName   String  @db.VarChar(255)
  storageKey String  @db.VarChar(500)
  mimeType   String  @db.VarChar(100)
  fileSize   BigInt
  checksum   String? @db.VarChar(128)

  uploadedBy String   @db.Uuid
  uploadedAt DateTime @default(now())

  deletedAt      DateTime?
  deletedBy      String?   @db.Uuid
  deletionReason String?   @db.VarChar(1000)

  document Document @relation(fields: [documentId], references: [documentId], onDelete: Cascade, onUpdate: Cascade)

  uploader User @relation("AttachmentUploader", fields: [uploadedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  deleter User? @relation("AttachmentDeletedBy", fields: [deletedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([documentId])
  @@index([documentId, deletedAt])
  @@index([uploadedBy])
  @@index([deletedBy])
  @@index([checksum])
  @@map("attachment")
}

// ============================================================
// 5. ORGANIZATIONAL UNIT
// ============================================================

model OrganizationalUnit {
  unitId       String  @id @default(uuid()) @db.Uuid
  parentUnitId String? @db.Uuid

  name     String   @db.VarChar(150)
  unitType UnitType
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent OrganizationalUnit? @relation("UnitHierarchy", fields: [parentUnitId], references: [unitId], onDelete: Restrict, onUpdate: Cascade)

  children OrganizationalUnit[] @relation("UnitHierarchy")

  users User[]

  currentCases Case[] @relation("CurrentCaseUnit")

  outgoingAssignments WorkflowAssignment[] @relation("AssignmentFromUnit")

  incomingAssignments WorkflowAssignment[] @relation("AssignmentToUnit")

  @@index([parentUnitId])
  @@index([unitType])
  @@index([isActive])
  @@map("organizational_unit")
}

// ============================================================
// 6. USER
// ============================================================

model User {
  userId String @id @default(uuid()) @db.Uuid

  unitId String? @db.Uuid
  roleId String  @db.Uuid

  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit OrganizationalUnit? @relation(fields: [unitId], references: [unitId], onDelete: Restrict, onUpdate: Cascade)

  role Role @relation(fields: [roleId], references: [roleId], onDelete: Restrict, onUpdate: Cascade)

  assignedWorkflows WorkflowAssignment[] @relation("AssignmentPerformedBy")

  statusChanges StatusHistory[] @relation("StatusChangedBy")

  remarks Remark[]

  decisions Decision[] @relation("DecisionMadeBy")

  uploadedDocuments Document[] @relation("DocumentUploader")

  deletedDocuments Document[] @relation("DocumentDeletedBy")

  uploadedAttachments Attachment[] @relation("AttachmentUploader")

  deletedAttachments Attachment[] @relation("AttachmentDeletedBy")

  auditLogs AuditLog[]

  notifications Notification[]

  @@index([unitId])
  @@index([roleId])
  @@index([isActive])
  @@map("user")
}

// ============================================================
// 7. ROLE
// ============================================================

model Role {
  roleId String @id @default(uuid()) @db.Uuid

  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  users       User[]
  permissions RolePermission[]

  @@index([isActive])
  @@map("role")
}

// ============================================================
// 8. PERMISSION
// ============================================================

model Permission {
  permissionId String @id @default(uuid()) @db.Uuid

  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(500)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)

  roles RolePermission[]

  @@index([resource])
  @@index([action])
  @@map("permission")
}

// ============================================================
// 10. ROLE PERMISSION
// ============================================================

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade, onUpdate: Cascade)

  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ============================================================
// 11. WORKFLOW ASSIGNMENT
// ============================================================

model WorkflowAssignment {
  assignmentId String @id @default(uuid()) @db.Uuid

  caseId String @db.Uuid

  fromUnitId String? @db.Uuid
  toUnitId   String  @db.Uuid

  assignedBy String @db.Uuid

  assignmentStatus AssignmentStatus @default(ACTIVE)

  remarks     String?   @db.VarChar(1000)
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  case Case @relation(fields: [caseId], references: [caseId], onDelete: Cascade, onUpdate: Cascade)

  fromUnit OrganizationalUnit? @relation("AssignmentFromUnit", fields: [fromUnitId], references: [unitId], onDelete: Restrict, onUpdate: Cascade)

  toUnit OrganizationalUnit @relation("AssignmentToUnit", fields: [toUnitId], references: [unitId], onDelete: Restrict, onUpdate: Cascade)

  assigner User @relation("AssignmentPerformedBy", fields: [assignedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  remarksHistory Remark[] @relation("AssignmentRemarks")

  @@index([caseId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@index([assignedBy])
  @@index([assignmentStatus])
  @@index([assignedAt])
  @@map("workflow_assignment")
}

// ============================================================
// 12. STATUS HISTORY
// ============================================================

model StatusHistory {
  statusHistoryId String @id @default(uuid()) @db.Uuid

  caseId    String     @db.Uuid
  changedBy String     @db.Uuid
  status    CaseStatus
  changedAt DateTime   @default(now())

  case Case @relation(fields: [caseId], references: [caseId], onDelete: Cascade, onUpdate: Cascade)

  changer User @relation("StatusChangedBy", fields: [changedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([caseId])
  @@index([changedBy])
  @@index([status])
  @@index([changedAt])
  @@map("status_history")
}

// ============================================================
// 13. REMARK
// ============================================================

model Remark {
  remarkId String @id @default(uuid()) @db.Uuid

  caseId       String  @db.Uuid
  userId       String  @db.Uuid
  assignmentId String? @db.Uuid

  remarkText String @db.VarChar(2000)

  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [caseId], onDelete: Cascade, onUpdate: Cascade)

  user User @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  assignment WorkflowAssignment? @relation("AssignmentRemarks", fields: [assignmentId], references: [assignmentId], onDelete: SetNull, onUpdate: Cascade)

  @@index([caseId])
  @@index([userId])
  @@index([assignmentId])
  @@map("remark")
}

// ============================================================
// 14. DECISION
// ============================================================

model Decision {
  decisionId String @id @default(uuid()) @db.Uuid

  caseId       String       @db.Uuid
  decidedBy    String       @db.Uuid
  decisionType DecisionType
  decisionText String?      @db.VarChar(2000)

  decidedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [caseId], onDelete: Cascade, onUpdate: Cascade)

  decider User @relation("DecisionMadeBy", fields: [decidedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([caseId])
  @@index([decidedBy])
  @@index([decisionType])
  @@index([decidedAt])
  @@map("decision")
}

// ============================================================
// 15. AUDIT LOG
// ============================================================

model AuditLog {
  auditLogId String @id @default(uuid()) @db.Uuid

  userId String  @db.Uuid
  caseId String? @db.Uuid

  action     String @db.VarChar(100)
  entityType String @db.VarChar(100)
  entityId   String @db.VarChar(100)

  oldValues Json?
  newValues Json?

  ipAddress String? @db.VarChar(45)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  case Case? @relation(fields: [caseId], references: [caseId], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([caseId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// 16. NOTIFICATION
// ============================================================

model Notification {
  notificationId String @id @default(uuid()) @db.Uuid

  userId String  @db.Uuid
  caseId String? @db.Uuid

  notificationType String @db.VarChar(100)
  title            String @db.VarChar(255)
  message          String @db.VarChar(2000)

  isRead Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)

  case Case? @relation(fields: [caseId], references: [caseId], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, isRead])
  @@index([caseId])
  @@index([createdAt])
  @@map("notification")
}
